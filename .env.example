# Copy this file to .env and replace all required placeholders.
# Never commit real credentials.

# Required for the Docker Compose stack
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_TOKEN=replace-with-a-random-string-at-least-32-characters-long
SLOT_SIGNING_KEY=replace-with-a-random-string-at-least-32-characters-long

# Browser origins allowed to embed the widget
ALLOWED_ORIGINS=https://demo-salon.example

# Database
POSTGRES_DB=booking
POSTGRES_USER=booking

# Optional integrations
AI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMTP_PASSWORD=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Public address used for customer action links
PUBLIC_BASE_URL=https://booking.demo-salon.example

# Operations
API_PORT=8080
NOTIFY_TICK_SECONDS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Optional structured-log export
AXIOM_TOKEN=
AXIOM_DATASET=booking-showcase

# Development-only flags; do not enable in production
# DB_ALLOW_SQLITE=1
# ADMIN_ALLOW_NO_TOKEN=1
# CORS_ALLOW_ALL=1

